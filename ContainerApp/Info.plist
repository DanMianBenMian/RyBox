<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleDisplayName</key>
    <string>RyBox</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- Scene-based UIApplicationMain lifecycle. RyBox itself is scene-capable so
         it owns a real UIWindowScene — in-process GUI guests (LiveContainer model)
         attach their window to THIS scene and drive their own SceneDelegate, which
         is the only way a modern scene-based guest app can build its real UI inside
         RyBox's process. Without a host scene there is nothing to attach to and
         scene guests show only their launch storyboard. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneConfigurationName</key>
                    <string>Default Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).RyBoxSceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>
    <!-- UIRequiresFullScreen keeps the iPad layout from letterboxing into an
         iPhone-sized frame. -->
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.containerapp.ipa</string>
            <key>UTTypeDescription</key>
            <string>iOS App Archive</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.zip</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>ipa</string></array>
            </dict>
        </dict>
        <!-- RyBox system-environment package (built on a computer with
             tools/build_ryboxenv.py). Declaring it here means the Files app
             shows it as a known archive type instead of an opaque blob.
             NOTE: pickers still filter with UTType.item only — filtering by a
             custom UTI makes files unselectable on iPadOS 27 beta. -->
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.rybox.ryboxenv</string>
            <key>UTTypeDescription</key>
            <string>RyBox System Environment</string>
            <key>UTTypeConformsTo</key>
            <array><string>public.zip-archive</string><string>public.data</string></array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array><string>ryboxenv</string></array>
            </dict>
        </dict>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.rybox.ios</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>rybox</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
